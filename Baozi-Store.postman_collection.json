      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Registro criado na lista\", () => pm.expect(pm.response.json().some(item => String(item.id) === pm.collectionVariables.get(\"clienteId\"))).to.be.true);"
            ]
          }
        }
