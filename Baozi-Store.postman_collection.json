          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi de carne suína\",\n  \"preco\": 12.00,\n  \"estoque\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
