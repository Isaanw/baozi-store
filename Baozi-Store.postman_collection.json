{
  "info": {
    "name": "Baozi Store",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Criar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Isadora da Silva5171883\",\n  \"clienteDesde\": \"2026-11-23\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const id = pm.response.json().id;",
              "    pm.test(\"ID retornado\", () => pm.expect(id).to.be.a(\"number\").above(0));",
              "    pm.collectionVariables.set(\"clienteId\", String(id));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Criar produto",
      "request": {
        "method": "POST",
        "header": [
          {
